# ==============================================================================
# ServiceMeow Enterprise Service Management - Environment Configuration
# ==============================================================================

# Database Connection String (PostgreSQL datasource)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/servicemeow?schema=public"

# Cryptographic Authentication Secret (MANDATORY IN PRODUCTION)
# Must be a cryptographically secure random string of at least 32 characters.
# Used for HMAC SHA-256 signing of session tokens across Edge Middleware and Node APIs.
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-char-min-cryptographic-secret-key-here"

# Application Environment Mode ('development' | 'production' | 'test')
NODE_ENV="development"

# HTTP Server Port
PORT=3000

# Background Worker & Scheduler Polling Interval in milliseconds (default: 15s)
WORKER_INTERVAL_MS=15000

# Security Gates & Hardening Flags (Strictly disabled by default)
# Set to 'false' in all environments to prevent unauthenticated persona bypasses
ALLOW_DEV_PERSONA_LOGIN="false"

# Set to 'false' in production. When false, only signed cryptographic tokens are accepted.
ALLOW_RAW_SESSION_ID="false"


# Seed passwords (used by prisma/seed.ts and scripts/seed-passwords.ts).
# If unset, random passwords are generated and printed once during seeding.
SEED_ADMIN_PASSWORD=""
SEED_DEFAULT_PASSWORD=""
