{
  "name": "servicemeow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-client.js && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "worker": "tsx src/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "node scripts/generate-client.js",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "capture:screenshots": "node scripts/capture-real-screenshots.js",
    "rust:test": "cargo test --manifest-path crates/servicemeow-core-engine/Cargo.toml",
    "rust:bench": "cargo run --release --manifest-path crates/servicemeow-core-engine/Cargo.toml -- bench",
    "rust:daemon": "cargo run --release --manifest-path crates/servicemeow-core-engine/Cargo.toml -- daemon",
    "rust:build": "cargo build --release --manifest-path crates/servicemeow-core-engine/Cargo.toml"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^15.2.1",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "prisma": "^6.4.1",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.4"
  }
}
